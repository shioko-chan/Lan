{people = table({
  name: ["小明", "小兰", "小杰", "小芳", "小雨", "小夏"],
  age: [20, 17, 31, missing, 25, 40],
  score: [80, missing, 58, 92, 75, missing],
  active: [true, true, true, false, true, true]
});

scored = people |> replace({score: .score ?? 0});

enriched = scored
  |> add({
    adult: (.age ?? 0) >= 18,
    passed: .score >= 60
  });

eligible = enriched
  |> filter(row => row.active and (row.adult ?? false) and row.passed);

ranked = eligible
  |> add({
    label: .name + "（入选）",
    order: -.score
  });

top = ranked
  |> sort_by("order")
  |> take(3)
  |> select_columns(["name", "age", "score", "label"]);

{
  result: top,
  summary: {
    rows: top |> row_count(),
    score_count: top |> count("score"),
    score_sum: top |> sum("score"),
    score_average: top |> average("score"),
    score_min: top |> min("score"),
    score_max: top |> max("score")
  }
}}
