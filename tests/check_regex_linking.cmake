file(COPY_FILE "${LANC}" "${OUTPUT}/lanc")
foreach(case regex_unused stdlib_regex)
  execute_process(COMMAND "${OUTPUT}/lanc" --build "${ROOT}/tests/${case}.lan"
    WORKING_DIRECTORY "${OUTPUT}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${case} build failed: ${out}${err}")
  endif()
endforeach()
if(EXISTS "${OUTPUT}/.lan/regex_unused/lan_regex_runtime.a")
  message(FATAL_ERROR "A program without Regex extracted the native archive")
endif()
if(NOT EXISTS "${OUTPUT}/.lan/stdlib_regex/lan_regex_runtime.a")
  message(FATAL_ERROR "Regex program did not extract its native archive")
endif()
file(READ "${OUTPUT}/.lan/stdlib_regex/REGEX_LICENSES.txt" notices)
if(NOT notices MATCHES "RE2" OR NOT notices MATCHES "Apache License")
  message(FATAL_ERROR "Regex runtime licenses were not distributed")
endif()
file(READ "${OUTPUT}/.lan/regex_unused/regex_unused.ll" ir)
if(ir MATCHES "call [^\n]*@lan_regex_(compile|search)")
  message(FATAL_ERROR "A program without Regex still calls RE2")
endif()
execute_process(COMMAND "${OUTPUT}/.lan/stdlib_regex/stdlib_regex"
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT out MATCHES "same_patterns: true")
  message(FATAL_ERROR "Standalone Regex executable failed: ${out}${err}")
endif()
