file(MAKE_DIRECTORY "${OUTPUT}")

function(reject name source expected)
  file(WRITE "${OUTPUT}/${name}.lan" "${source}\n")
  execute_process(COMMAND "${LANC}" "${OUTPUT}/${name}.lan" -o "${OUTPUT}/${name}.ll"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "${name}: expected '${expected}': ${output}${error}")
  endif()
endfunction()

reject(no_bind "do {1}" "至少需要一个 <-")
reject(mixed "do {a <- parse_number(\"1\"); b <- ok(2); a + b}" "不能混用")
reject(error_type "do {a <- if true {ok(1)} else {err(\"x\")}; b <- if true {ok(2)} else {err(3)}; a + b}" "错误类型|种类不同")
reject(outer_option "f(flag) = if flag {ok(1)} else {missing}\ndo {x <- f(true); x}" "先处理外层 Option")
reject(scope "{x = do {value <- parse_number(\"1\"); value}; value}" "找不到名称")
reject(bare_step "do {parse_number(\"1\"); 2}" "无法理解")
reject(missing_final_separator "do {x <- parse_number(\"1\") x}" "无法理解")
reject(update_target "do {x <- parse_number(\"1\"); get().a = x; x}" "无法理解|字段更新")
reject(io_mix "do {x <- io {1}; x}" "IO|Option")
reject(reserved "do(x) = x\ndo(1)" "保留|无法理解")

function(run name source expected)
  file(WRITE "${OUTPUT}/${name}.lan" "${source}\n")
  execute_process(COMMAND "${LANC}" --run "${OUTPUT}/${name}.lan"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0 OR NOT output STREQUAL "${expected}\n")
    message(FATAL_ERROR "${name}: expected '${expected}', got ${output}${error}")
  endif()
endfunction()

run(braces "(do {x <- parse_number(\"4\"); x + 1})?" "5")
run(layout "f() = do\n  x <- parse_number(\"4\")\n  x + 1\nf()?" "5")
run(result "do {x <- ok(4); x + 1}" "ok(5)")
run(result_nested "do {x <- ok(4); ok(x + 1)}" "ok(ok(5))")
run(option_result "(do {x <- parse_number(\"4\"); ok(x + 1)})?" "ok(5)")
run(result_option "do {x <- ok(parse_number(\"bad\")); x}" "ok(missing)")
run(question_rhs "(do {x <- parse_number(\"bad\")?; x})?" "missing")
run(question_final "do {x <- ok(1); missing?}" "ok(missing)")
run(ordinary_binding "do {x <- ok(1); saved = err(\"not propagated\"); saved}" "ok(err(\"not propagated\"))")
run(active_failure "do {x <- if true {err(\"stop\")} else {ok(1)}; x}" "err(\"stop\")")
run(direct_present "do {x <- 4; x + 1}" "5")
run(ignore "do {_ <- ok(1); 2}" "ok(2)")
run(nested "do {x <- ok(2); y <- do {z <- ok(3); z + 1}; x + y}" "ok(6)")
run(field_names "{r = {do: 2}; r.do}" "2")
run(left_once "{r = {count: 0}; value = do {x <- parse_number(\"4\"); x}; value ?? 0}" "4")
run(function_result "forward(input) = do {x <- input; x}\nforward(ok(4))" "ok(4)")
run(function_option "forward(input) = do {x <- input; x}\nforward(parse_number(\"4\"))?" "4")
