decide(flag) =
  if flag
    4
  else
    missing

demo(flag) =
  value = decide(flag)
  refined = if not is_missing(value)
    value + 1
  else
    0
  not_missing = not missing?
  false_and_missing = false and missing?
  true_and_missing = true and missing?
  missing_and_false = missing? and false
  missing_and_true = missing? and true
  true_or_missing = true or missing?
  false_or_missing = false or missing?
  missing_or_true = missing? or true
  missing_or_false = missing? or false
  {
    not_missing: not_missing,
    false_and_missing: false_and_missing,
    true_and_missing: true_and_missing,
    missing_and_false: missing_and_false,
    missing_and_true: missing_and_true,
    true_or_missing: true_or_missing,
    false_or_missing: false_or_missing,
    missing_or_true: missing_or_true,
    missing_or_false: missing_or_false,
    parenthesized_coalesce: true and (missing ?? false),
    refined: refined,
    required: require(3)
  }

[demo(true), demo(false)]
