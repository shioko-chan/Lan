{numbers = [1, missing, 3];
flags = [true, missing, false, true];
texts = ["A", missing, "B", "C", "D"];
nested = [[1], missing];
calculated = numbers + [10, 20, 30];
scaled = numbers + 10;
scaled_again = scaled + [1, 2, 3];
truths = flags and true;
paired_truths = flags or [false, true, missing];
labels = texts + "!";
{
  calculated: calculated,
  numbers: numbers,
  flags: flags,
  texts: texts,
  nested: nested,
  paired_truths: paired_truths,
  scaled: scaled,
  scaled_again: scaled_again,
  truths: truths,
  labels: labels
}}
