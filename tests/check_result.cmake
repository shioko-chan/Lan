file(MAKE_DIRECTORY "${OUTPUT}")
function(reject name source expected)
  file(WRITE "${OUTPUT}/${name}.lan" "${source}\n")
  execute_process(COMMAND "${LANC}" "${OUTPUT}/${name}.lan" -o "${OUTPUT}/${name}.ll"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "${name}: expected '${expected}': ${output}${error}")
  endif()
endfunction()
reject(incomplete_ok "match ok(1) {ok(x) => x}" "未穷尽")
reject(incomplete_err "match err(1) {err(x) => x}" "未穷尽")
reject(duplicate "match ok(1) {ok(x) => x; ok(_) => 0; err(_) => 0}" "重复|不可达")
reject(after_wildcard "match ok(1) {_ => 0; err(_) => 1}" "重复|不可达")
reject(after_value "match ok(1) {value(x) => 0; err(_) => 1}" "重复|不可达")
reject(wrong_subject "match 1 {ok(x) => x; err(_) => 0}" "Result")
reject(literal_subject "match ok(1) {1 => 0; _ => 1}" "种类不同")
reject(no_auto_wrap "if true {ok(1)} else {2}" "种类不同")
reject(no_auto_unwrap "ok(1) + 2" "种类不同|只能")
reject(no_question_unwrap "ok(1)? + 2" "种类不同|只能")
reject(no_coalesce_unwrap "ok(1) ?? 2" "种类不同")
reject(no_equality "ok(1) == ok(1)" "same")
reject(success_type "if true {ok(1)} else {ok(\"x\")}" "种类不同")
reject(error_type "if true {err(1)} else {err(\"x\")}" "种类不同")
reject(list_type "[ok(1), ok(true)]" "种类不同")
reject(payload_option "require(ok(missing)) + 1" "Option 类型错误")
reject(bound_option "match ok(parse_number(\"x\")) {ok(x) => x + 1; err(_) => 0}" "Option 类型错误")
reject(error_option "match err(parse_number(\"x\")) {ok(_) => 0; err(e) => e + 1}" "Option 类型错误")
reject(outer_option "f(b) = if b {ok(1)} else {missing}\nrequire(f(true))" "Option 类型错误")
reject(outer_coverage "f(b) = if b {ok(1)} else {missing}\nmatch f(true) {ok(x) => x; err(_) => 0}" "未穷尽")
reject(scope "{x = match ok(1) {ok(n) => n; err(_) => 0}; n}" "找不到名称")
reject(binding_is_result "match ok(1) {result => result + 1}" "种类不同|只能")
reject(arity "ok(1, 2)" "需要 1")
reject(no_arg "err()" "需要 1")
reject(reserved "ok(x) = x\nok(1)" "保留")
reject(io_payload "ok(io {1})" "载荷不能是 IO")
reject(io_discard "io {io {err(\"bad\")}; 1}" "不能隐式丢弃 Result")
reject(infinite "f(x) = match x {ok(y) => x; err(e) => e}\nf(ok(1))" "无限嵌套")

function(run name source expected)
  file(WRITE "${OUTPUT}/${name}.lan" "${source}\n")
  execute_process(COMMAND "${LANC}" --run "${OUTPUT}/${name}.lan"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0 OR NOT output STREQUAL "${expected}\n")
    message(FATAL_ERROR "${name}: expected '${expected}', got ${output}${error}")
  endif()
endfunction()
run(display_ok "ok(42)" "ok(42)")
run(display_err "err(\"bad\")" "err(\"bad\")")
run(display_unit "ok(())" "ok(())")
run(display_io "io {err(\"bad\")}" "err(\"bad\")")
run(catchall "match err(\"bad\") {ok(_) => err(\"wrong\"); rest => rest}" "err(\"bad\")")
run(require_record "{r = {answer: ok(42)}; require(r.answer)}" "42")
run(require_nested "require(require(ok(ok(42))))" "42")
run(require_io "f(x) = require(x)\nio {r <- io {ok(42)}; f(r)}" "42")
run(require_record_chain "{r = {answer: ok({value: ok(42)})}; require(require(r.answer).value)}" "42")
run(pipe_constructor "42 |> ok() |> require()" "42")
run(constructors_as_fields "{r = {ok: 1, err: 2}; r.ok + r.err}" "3")
run(named_default "f(value = ok(7)) = require(value)\nf(value = ok(42))" "42")
run(nested_match "match ok(err(\"bad\")) {ok(inner) => match inner {ok(_) => \"wrong\"; err(e) => e}; err(_) => \"wrong\"}" "bad")
run(escaped_branch "{value = match ok(1) {ok(_) => missing?; err(_) => 0}; is_missing(value)}" "true")
run(result_table "{t = table({answer: [ok(1), err(\"bad\")]}); t |> map(match .answer {ok(n) => n; err(_) => 0})}" "[1, 0]")
run(result_flatten "flatten([[ok(1)], [err(\"bad\")]])" "[ok(1), err(\"bad\")]")
run(result_fill "[ok(1), missing] ?? ok(2)" "[ok(1), ok(2)]")
run(result_remaining "{r = err(\"bad\"); match r {ok(_) => false; rest => same(rest, r)}}" "true")
run(result_payload_lifetime "f() = require(ok([uppercase(\"retained\")]))\nf()" "[\"RETAINED\"]")
run(result_original_binding "{r = ok(42); match r {ok(n) => same(r, ok(n)); err(_) => false}}" "true")
run(option_result_question "f(b) = if b {ok(42)} else {missing}\n{a = f(false)?; is_missing(a)}" "true")

foreach(case text regex)
  if(case STREQUAL "text")
    set(payload "{code: \"bad\", detail: [\"a\", \"b\"]}")
    set(expected "require 收到 err.*bad")
  else()
    set(payload "regex(\"a+\")")
    set(expected "require 收到 err\\(<Regex>\\)")
  endif()
  file(WRITE "${OUTPUT}/error_${case}.lan" "require(err(${payload}))\n")
  execute_process(COMMAND "${LANC}" --run "${OUTPUT}/error_${case}.lan"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "error_${case}: ${output}${error}")
  endif()
endforeach()
