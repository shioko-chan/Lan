file(MAKE_DIRECTORY "${OUTPUT}")

function(reject name source)
  set(path "${OUTPUT}/${name}.lan")
  file(WRITE "${path}" "${source}\n")
  execute_process(COMMAND "${LANC}" "${path}" -o "${OUTPUT}/${name}.ll"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "Option 类型错误")
    message(FATAL_ERROR "${name}: expected static Option rejection: ${output}${error}")
  endif()
endfunction()

reject(arithmetic "missing + 1")
reject(unary "-missing")
reject(boolean_not "not missing")
reject(boolean_and "true and missing")
reject(boolean_or "missing or true")
reject(condition "if missing { 1 } else { 2 }")
reject(builtin "length(missing)")
reject(user_call "double(x) = x * 2\ndouble(parse_number(\"1\"))")
reject(default "bad(x = missing) = x + 1\nbad()")
reject(unused "bad() = missing + 1\n42")
reject(named "double(x) = x * 2\ndouble(x = missing)")
reject(list_elements "[1, missing] |> map(. + 1)")
reject(nested_elements "[[1], missing] |> map(length(.))")
reject(index_object "[[1]].0.0")
reject(index "[1].(missing)")
reject(unknown_field "{key = \"age\"; r = {(key): 1}; r.(key) + 1}")
reject(optional_field "{r = {age: missing}; r.age + 1}")
reject(field_update "{r = {age: 1}; r.age = missing; r.age + 1}")
reject(dynamic_update "{key = \"age\"; r = {age: 1}; r.(key) = missing; r.age + 1}")
reject(merge_overwrite "{key = \"age\"; r = merge({age: 1}, {(key): missing}); r.age + 1}")
reject(shadowing "{x = parse_number(\"1\"); if is_missing(x) { 0 } else {x = missing; x + 1}}")
reject(after_branch "{x = parse_number(\"1\"); ignored = if is_missing(x) {0} else {x + 1}; x + 1}")
reject(wrong_branch "{x = parse_number(\"1\"); if is_missing(x) {x + 1} else {0}}")
reject(io_result "io { x <- io { missing }; x + 1 }")
reject(io_action "f(ok) = if ok { io { () } } else { missing }\nio { f(false) }")
reject(root_io_action "f(ok) = if ok { io { () } } else { missing }\nf(false)?")
reject(whole_list "f(ok) = if ok { [1] } else { missing }\nlength(f(true))")
reject(wrong_fallback "f(ok) = if ok { [1] } else { missing }\nf(false) ?? 0")
reject(join "join([\"a\", missing], \",\")")
reject(flatten "flatten([[1], missing])")
reject(table_row "table([{age: 1}, missing])")
reject(table_column "table({age: missing})")
reject(table_cell "table({age: [1, missing]}) |> map(.age + 1)")
reject(column_name "select_columns(table({age: [1]}), [\"age\", missing])")
reject(table_replace "{key = \"age\"; t = table({age: [1]}) |> replace({(key): missing}); t |> map(.age + 1)}")
reject(optional_any "if [missing, true] |> any(.) {1} else {2}")
reject(final "parse_number(\"1\")")
reject(mixed_coalesce "f(xs) = xs ?? [0]\ng(ok) = if ok {[1]} else {missing}\n[f([1]), f(g(false))]")

# Runtime rejection remains an explicit, checked operation; it is not removed
# merely because the compiler can see a missing value.
file(WRITE "${OUTPUT}/require.lan" "require(parse_number(\"invalid\"))\n")
execute_process(COMMAND "${LANC}" --run "${OUTPUT}/require.lan"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "运行错误")
  message(FATAL_ERROR "require must compile and reject at runtime: ${output}${error}")
endif()
